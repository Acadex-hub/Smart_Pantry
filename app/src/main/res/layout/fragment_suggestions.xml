<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="What's cooking?" android:fontFamily="serif" android:textStyle="bold"
            android:textSize="30sp" android:textColor="@color/green_deep" android:layout_margin="20dp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvHero" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_hero" android:textColor="@color/white" android:textSize="16sp"
            android:padding="20dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🍽️\nNo recipes match your pantry yet\n- add more ingredients" android:gravity="center"
            android:textSize="16sp" android:textColor="@color/muted" android:padding="40dp" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvStrict" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
        <TextView android:id="@+id/tvAlmostHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🛒 Almost there — just one ingredient missing" android:fontFamily="serif" android:textStyle="bold"
            android:textSize="18sp" android:textColor="@color/mustard" android:layout_margin="20dp" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAlmost" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
