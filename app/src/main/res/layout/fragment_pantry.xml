<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="My Pantry" android:fontFamily="serif" android:textStyle="bold"
            android:textSize="30sp" android:textColor="@color/green_deep" android:layout_margin="20dp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvHero" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_hero" android:textColor="@color/white" android:textSize="16sp"
            android:padding="20dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvAlert" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/tomato" android:textStyle="bold" android:visibility="gone"
            android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🧺\nYour pantry is empty.\nTap “Add” to stock your first ingredient."
            android:gravity="center" android:textSize="16sp" android:textColor="@color/muted"
            android:padding="40dp" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPantry"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingTop="8dp" android:paddingBottom="90dp" android:clipToPadding="false"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="20dp" android:text="Add" 
        app:backgroundTint="@color/tomato" android:textColor="@color/white"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
