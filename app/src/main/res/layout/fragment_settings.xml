<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings"
        android:fontFamily="serif" android:textStyle="bold" android:textSize="30sp" android:textColor="@color/green_deep" android:layout_marginBottom="16dp"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="20dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swExpiring"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⏳ Expiring-soon alerts (3 days)"/>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAlmost"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="🛒 Show “Almost There” recipes (bonus)"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="🌱 Smart Pantry Manager v1.0\nSuggests recipes using strictly what you already own — cook more, waste less."
        android:textColor="@color/muted" android:gravity="center"/>
</LinearLayout>
